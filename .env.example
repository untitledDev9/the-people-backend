# Server
PORT=4000
NODE_ENV=development

# Public URL(s) of the Next.js client, comma separated (used for CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/5000-people

# Auth: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cookie settings. Local dev: lax. If client and API are on different sites in production
# (e.g. vercel.app + onrender.com) use COOKIE_SAMESITE=none. If they share a parent domain
# (app.example.com + api.example.com) keep lax and set COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Cloudinary (https://console.cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
